# Supabase > Project Settings > Database > Connection string
# DATABASE_URL: connection pooler (puerto 6543, para la app en runtime)
DATABASE_URL="postgresql://postgres.xxxxx:password@aws-0-xx-xxxx-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL: conexión directa (puerto 5432, solo para migraciones)
DIRECT_URL="postgresql://postgres.xxxxx:password@aws-0-xx-xxxx-1.pooler.supabase.com:5432/postgres"

JWT_SECRET="cambiar-por-un-secreto-largo-y-aleatorio"
PORT=3001
